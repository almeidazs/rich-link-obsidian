{
	"name": "rich-link-obsidian",
	"version": "0.4.0",
	"private": true,
	"description": "Obsidian plugin that converts pasted or selected URLs into markdown rich links with favicon and title.",
	"keywords": [
		"bookmark",
		"favicon",
		"link-preview",
		"markdown",
		"obsidian",
		"obsidian-md",
		"obsidian-plugin",
		"paste",
		"rich-link"
	],
	"homepage": "https://github.com/almeidazs/rich-link-obsidian#readme",
	"bugs": {
		"url": "https://github.com/almeidazs/rich-link-obsidian/issues"
	},
	"license": "Apache-2.0",
	"author": {
		"name": "Hiago Almeida",
		"url": "https://github.com/almeidazs"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/almeidazs/rich-link-obsidian.git"
	},
	"type": "module",
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"check": "ultracite check && npm run typecheck && npm test && npm run build",
		"clean": "rm -f main.js",
		"format": "ultracite fix",
		"lint": "ultracite check",
		"lint:fix": "ultracite fix",
		"test": "node --test \"tests/**/*.test.ts\"",
		"test:watch": "node --test --watch \"tests/**/*.test.ts\"",
		"typecheck": "tsc --noEmit",
		"prepare": "if [ -z \"$CI\" ] && [ -d .git ]; then lefthook install; fi"
	},
	"devDependencies": {
		"@commitlint/cli": "^20.5.3",
		"@commitlint/config-conventional": "^20.5.3",
		"lefthook": "^1.13.6",
		"linkedom": "^0.18.15",
		"obsidian": "^1.12.3",
		"oxfmt": "^0.70.0",
		"oxlint": "^1.95.0",
		"tsdown": "^0.23.7",
		"typescript": "^7.0.2",
		"ultracite": "^7.12.4"
	},
	"engines": {
		"node": ">=22.18.0"
	}
}
